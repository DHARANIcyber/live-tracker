{
  "name": "live2",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "start:combined": "node backend/server.js",
    "start:secure": "npm run build && set USE_HTTPS=true&& node backend/server.js",
    "build": "npm --prefix frontend run build",
    "share": "npx localtunnel --port 5000",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start"
  },
  "dependencies": {
    "firebase": "^12.16.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
